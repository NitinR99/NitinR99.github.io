{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@content/*": ["./content/*"],
      "@theme/*": ["./.vitepress/theme/*"]
    }
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "content/**/*.ts"]
}
